# Example environment variables for J.A.R.V.I.S
# Copy this file to .env and fill in your actual values

# Required LLM
LLM_PROVIDER=omniroute
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=your_omniroute_api_key_here
OMNIROUTE_MODEL=your_model
OMNIROUTE_TIMEOUT=180

# Face Auth (tune as needed)
JARVIS_AUTH_ID=1
JARVIS_AUTH_FRAMES=3
JARVIS_AUTH_TIMEOUT=20
JARVIS_AUTH_THRESHOLD=0.9
JARVIS_AUTH_OVERLAY_SECONDS=4

# Voice Fallback
JARVIS_VOICE_ENABLED=1
JARVIS_VOICE_PHRASE=genius billionaire playboy philanthropist
JARVIS_VOICE_TIMEOUT=20

# Local Neural TTS
# Kokoro runs locally after its model assets are downloaded once.
# No recurring API quota is required.
JARVIS_TTS_ENABLED=1
JARVIS_TTS_ENGINE=kokoro
JARVIS_TTS_LANGUAGE=auto
JARVIS_TTS_EN_VOICE=bm_george
JARVIS_TTS_HI_VOICE=hm_omega
JARVIS_KOKORO_SPEED=0.92
JARVIS_TTS_SENTENCE_PAUSES=1

# MongoDB Chat History (optional; separate from long-term memory)
MONGODB_URI=mongodb://127.0.0.1:27017/jarvis
JARVIS_CHAT_COLLECTION=chats
JARVIS_CONTEXT_TURNS=8

# Phase 8.1 — Contextual Interpretation
# auto: interpret microphone speech except clear known-app launches; typed text
# is interpreted when context, follow-up wording, or a target-sensitive action warrants it
# always: interpret all non-empty input; off: disable contextual interpretation
JARVIS_INTERPRETATION_MODE=auto
JARVIS_INTERPRETATION_MIN_CONFIDENCE=0.70

# Phase 8.2 — Persistent Long-Term Memory (local SQLite; no extra package)
JARVIS_MEMORY_ENABLED=1
JARVIS_MEMORY_DB_PATH=data/jarvis_memory.db
JARVIS_MEMORY_AUTO_EXTRACT=1
JARVIS_MEMORY_MIN_CONFIDENCE=0.72
JARVIS_MEMORY_CONTEXT_ITEMS=5

# Phase 8.3 — structured user profile/preferences/work context
JARVIS_PROFILE_CONTEXT_ITEMS=5
JARVIS_EPISODIC_MEMORY_TTL_DAYS=90
